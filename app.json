{
  "expo": {
    "name": "Amortix",
    "slug": "amortix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Amortix.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "amortix",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/Amortix.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amortix.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Amortix-adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.amortix.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/Amortix.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.167295983795-s0bgl7ntu3ngenaa3gravk65s13d8i8h"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f249ad5b-630e-4bcc-8c46-f0124eca32da"
      }
    }
  }
}
