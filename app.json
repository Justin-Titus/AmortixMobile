{
  "expo": {
    "name": "Amortix",
    "slug": "amortix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Amortix.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "amortix",
    "splash": {
      "image": "./assets/Amortix-adaptive.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b2f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amortix.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Amortix-adaptive.png",
        "backgroundColor": "#0d1b2f"
      },

      "package": "com.amortix.app"
    },
    "web": {
      "favicon": "./assets/Amortix.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.167295983795-s0bgl7ntu3ngenaa3gravk65s13d8i8h"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f249ad5b-630e-4bcc-8c46-f0124eca32da"
      }
    }
  }
}
